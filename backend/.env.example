# Application Environment Configuration
APP_NAME="Face Recognition Attendance System"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (SQLite for local dev, PostgreSQL + pgvector for production)
DATABASE_URL="sqlite:///./attendance_v2.db"
# Example PostgreSQL with pgvector:
# DATABASE_URL="postgresql://user:password@localhost:5432/attendance_db"

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://your-frontend.vercel.app"

# Biometric & ML Engine
FAR_THRESHOLD=0.42
LIVENESS_THRESHOLD=0.50
SMOOTHING_WINDOW=5
CONSECUTIVE_AGREEMENTS=3
COOLDOWN_SECONDS=30
